{
  "info": {
    "_postman_id": "a79db9d6-9874-41cb-a631-a5391769bc25",
    "name": "Flash Booking | Guia executável",
    "description": "Esta é a única coleção Postman do projeto. Ela é uma documentação executável: execute Local após iniciar Docker Compose, ou AWS após preencher URL temporária, credenciais IAM/SigV4 e destinatário SES verificado. Os requests precisam ser enviados em ordem.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "awsv4",
    "awsv4": [
      { "key": "accessKey", "value": "{{awsAccessKeyId}}", "type": "string" },
      { "key": "secretKey", "value": "{{awsSecretAccessKey}}", "type": "string" },
      { "key": "sessionToken", "value": "{{awsSessionToken}}", "type": "string" },
      { "key": "region", "value": "{{awsRegion}}", "type": "string" },
      { "key": "service", "value": "execute-api", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = Date.now();",
          "pm.collectionVariables.set('saleStartsAt', new Date(now + 2 * 60 * 1000).toISOString());",
          "pm.collectionVariables.set('saleEndsAt', new Date(now + 11 * 60 * 1000).toISOString());"
        ]
      }
    }
  ],
  "variable": [
    { "key": "runId", "value": "", "type": "string" },
    { "key": "eventId", "value": "", "type": "string" },
    { "key": "reservationId", "value": "", "type": "string" },
    { "key": "futureEventId", "value": "", "type": "string" },
    { "key": "createEventKey", "value": "", "type": "string" },
    { "key": "reservationKey", "value": "", "type": "string" },
    { "key": "insufficientCapacityKey", "value": "", "type": "string" },
    { "key": "cancelReservationKey", "value": "", "type": "string" },
    { "key": "futureEventKey", "value": "", "type": "string" },
    { "key": "beforeStartKey", "value": "", "type": "string" },
    { "key": "saleStartsAt", "value": "", "type": "string" },
    { "key": "saleEndsAt", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "00 | Como usar esta coleção",
      "description": "1. Importe esta coleção e um ambiente de postman/. 2. Local: execute docker compose up --build --detach, selecione Flash Booking Local e rode a pasta Local. 3. AWS: selecione Flash Booking AWS, preencha somente os valores do ambiente ativo e rode AWS. A coleção guarda IDs e chaves de idempotência em variáveis próprias durante cada fluxo.",
      "item": []
    },
    {
      "name": "Local | fluxo completo do case",
      "description": "Command API: {{commandBaseUrl}}. Query API: {{queryBaseUrl}}. Esta pasta usa noauth porque Docker Compose não possui API Gateway/IAM.",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "01 | Criar evento imediato",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{createEventKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman {{runId}} - evento imediato\",\n  \"capacity\": 2\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{commandBaseUrl}}/events",
            "description": "Reinicia as variáveis do fluxo. Evento sem janela aceita reservas imediatamente quando possui capacidade."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now().toString();",
                  "pm.collectionVariables.set('runId', runId);",
                  "pm.collectionVariables.set('eventId', '');",
                  "pm.collectionVariables.set('reservationId', '');",
                  "pm.collectionVariables.set('futureEventId', '');",
                  "pm.collectionVariables.set('createEventKey', `postman-${runId}-event`);",
                  "pm.collectionVariables.set('reservationKey', `postman-${runId}-reservation`);",
                  "pm.collectionVariables.set('insufficientCapacityKey', `postman-${runId}-insufficient`);",
                  "pm.collectionVariables.set('cancelReservationKey', `postman-${runId}-cancel`);",
                  "pm.collectionVariables.set('futureEventKey', `postman-${runId}-future-event`);",
                  "pm.collectionVariables.set('beforeStartKey', `postman-${runId}-before-start`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('cria evento com 201', () => pm.response.to.have.status(201));",
                  "const event = pm.response.json();",
                  "pm.test('evento inicia com a capacidade disponível', () => { pm.expect(event.capacity).to.eql(2); pm.expect(event.available).to.eql(2); });",
                  "pm.test('evento imediato não possui janela configurada', () => { pm.expect(event.startsAt).to.eql(null); pm.expect(event.endsAt).to.eql(null); });",
                  "pm.collectionVariables.set('eventId', event.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 | Consultar disponibilidade",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{queryBaseUrl}}/events/{{eventId}}",
            "description": "A Query API pode responder via cache-aside ou PostgreSQL. O contrato deve retornar a mesma capacidade."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('consulta evento com 200', () => pm.response.to.have.status(200));",
                "pm.test('disponibilidade inicial é 2', () => pm.expect(pm.response.json().available).to.eql(2));"
              ] }
            }
          ]
        },
        {
          "name": "03 | Criar reserva",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{reservationKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 1,\n  \"customer\": { \"name\": \"Postman Smoke\", \"email\": \"{{customerEmail}}\" }\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{commandBaseUrl}}/events/{{eventId}}/reservations",
            "description": "Command API reserva uma unidade. Inventário, cliente, reserva, idempotência e outbox pertencem à mesma transação."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('cria reserva com 201', () => pm.response.to.have.status(201));",
                "const reservation = pm.response.json();",
                "pm.test('reserva inicia pendente com uma unidade', () => { pm.expect(reservation.status).to.eql('PENDING'); pm.expect(reservation.quantity).to.eql(1); });",
                "pm.collectionVariables.set('reservationId', reservation.id);"
              ] }
            }
          ]
        },
        {
          "name": "04 | Repetir reserva com a mesma chave",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{reservationKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 1,\n  \"customer\": { \"name\": \"Postman Smoke\", \"email\": \"{{customerEmail}}\" }\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{commandBaseUrl}}/events/{{eventId}}/reservations",
            "description": "Retry idêntico deve devolver a resposta persistida e não reduzir a disponibilidade novamente."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('replay idempotente retorna 201', () => pm.response.to.have.status(201));",
                "pm.test('replay devolve a mesma reserva', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('reservationId')));"
              ] }
            }
          ]
        },
        {
          "name": "05 | Consultar reserva",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{queryBaseUrl}}/reservations/{{reservationId}}",
            "description": "A consulta de reserva lê PostgreSQL diretamente e referencia o evento como { id, name }."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('consulta reserva com 200', () => pm.response.to.have.status(200));",
                "const reservation = pm.response.json();",
                "pm.test('reserva referencia o evento e permanece pendente', () => { pm.expect(reservation.event.id).to.eql(pm.collectionVariables.get('eventId')); pm.expect(reservation.status).to.eql('PENDING'); });"
              ] }
            }
          ]
        },
        {
          "name": "06 | Rejeitar capacidade insuficiente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{insufficientCapacityKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2,\n  \"customer\": { \"name\": \"Capacidade Insuficiente\", \"email\": \"{{customerEmail}}\" }\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{commandBaseUrl}}/events/{{eventId}}/reservations",
            "description": "Depois da primeira reserva, restou uma unidade. Pedir duas deve falhar sem efeito parcial."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('capacidade insuficiente retorna 409', () => pm.response.to.have.status(409));",
                "pm.test('conflito usa Problem Details', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));"
              ] }
            }
          ]
        },
        {
          "name": "07 | Cancelar reserva antes do prazo",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Idempotency-Key", "value": "{{cancelReservationKey}}", "type": "text" } ],
            "url": "{{commandBaseUrl}}/reservations/{{reservationId}}",
            "description": "Antes de expiresAt, a reserva fica CANCELLED, grava CANCELLED_BY_REQUEST e devolve capacidade uma vez."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('cancelamento retorna 200', () => pm.response.to.have.status(200));",
                "const reservation = pm.response.json();",
                "pm.test('cancelamento preserva motivo auditável', () => { pm.expect(reservation.status).to.eql('CANCELLED'); pm.expect(reservation.closureReason.code).to.eql('CANCELLED_BY_REQUEST'); });"
              ] }
            }
          ]
        },
        {
          "name": "08 | Confirmar capacidade devolvida",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{queryBaseUrl}}/events/{{eventId}}",
            "description": "Confirma que somente a primeira transição terminal devolveu a unidade."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('consulta pós-cancelamento retorna 200', () => pm.response.to.have.status(200));",
                "pm.test('capacidade volta a 2', () => pm.expect(pm.response.json().available).to.eql(2));"
              ] }
            }
          ]
        },
        {
          "name": "09 | Rejeitar comando sem Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman sem chave\",\n  \"capacity\": 1\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{commandBaseUrl}}/events",
            "description": "Todo comando mutável exige Idempotency-Key; a API rejeita a requisição antes de criar o evento."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('chave ausente retorna 400', () => pm.response.to.have.status(400));",
                "pm.test('erro usa Problem Details', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));"
              ] }
            }
          ]
        },
        {
          "name": "10 | Criar venda futura",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{futureEventKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman {{runId}} - venda futura\",\n  \"capacity\": 1,\n  \"startsAt\": \"{{saleStartsAt}}\",\n  \"endsAt\": \"{{saleEndsAt}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{commandBaseUrl}}/events",
            "description": "Cria uma janela que abre dois minutos no futuro e retorna os instantes ISO-8601 persistidos."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('cria venda futura com 201', () => pm.response.to.have.status(201));",
                "const event = pm.response.json();",
                "pm.test('retorna a janela solicitada', () => { pm.expect(event.startsAt).to.eql(pm.collectionVariables.get('saleStartsAt')); pm.expect(event.endsAt).to.eql(pm.collectionVariables.get('saleEndsAt')); });",
                "pm.collectionVariables.set('futureEventId', event.id);"
              ] }
            }
          ]
        },
        {
          "name": "11 | Rejeitar reserva antes da abertura",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{beforeStartKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 1,\n  \"customer\": { \"name\": \"Venda Futura\", \"email\": \"{{customerEmail}}\" }\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{commandBaseUrl}}/events/{{futureEventId}}/reservations",
            "description": "Antes de startsAt, a janela é rejeitada pelo mesmo decremento condicional que protege a capacidade."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('reserva antes da abertura retorna 409', () => pm.response.to.have.status(409));",
                "pm.test('erro de janela usa Problem Details', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));"
              ] }
            }
          ]
        }
      ]
    },
    {
      "name": "AWS | fronteira e fluxo do case",
      "description": "Esta pasta herda AWS Signature v4 da coleção. Preencha no ambiente AWS somente a URL temporária, credenciais da ApiInvokerRole e customerEmail aceito pelo SES. O primeiro request usa noauth intencionalmente e deve retornar 403; todos os demais são assinados.",
      "item": [
        {
          "name": "00 | Rejeitar chamada sem SigV4",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{queryBaseUrl}}/events/00000000-0000-0000-0000-000000000000",
            "description": "O API Gateway deve bloquear chamadas sem assinatura antes que elas atinjam o ALB ou a aplicação."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [ "pm.test('borda sem assinatura retorna 403', () => pm.response.to.have.status(403));" ] }
            }
          ]
        },
        {
          "name": "01 | Criar evento assinado",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{createEventKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman {{runId}} - AWS\",\n  \"capacity\": 2\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{commandBaseUrl}}/events",
            "description": "Inicia o fluxo assinado. A regra de negócio é idêntica à Local; a diferença é a fronteira IAM/SigV4."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now().toString();",
                  "pm.collectionVariables.set('runId', runId);",
                  "pm.collectionVariables.set('eventId', '');",
                  "pm.collectionVariables.set('reservationId', '');",
                  "pm.collectionVariables.set('createEventKey', `postman-${runId}-event`);",
                  "pm.collectionVariables.set('reservationKey', `postman-${runId}-reservation`);",
                  "pm.collectionVariables.set('insufficientCapacityKey', `postman-${runId}-insufficient`);",
                  "pm.collectionVariables.set('cancelReservationKey', `postman-${runId}-cancel`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('cria evento assinado com 201', () => pm.response.to.have.status(201));",
                "const event = pm.response.json();",
                "pm.test('evento AWS inicia com capacidade 2', () => { pm.expect(event.capacity).to.eql(2); pm.expect(event.available).to.eql(2); });",
                "pm.collectionVariables.set('eventId', event.id);"
              ] }
            }
          ]
        },
        {
          "name": "02 | Consultar evento assinado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{queryBaseUrl}}/events/{{eventId}}",
            "description": "Consulta assinada, roteada ao query-api pelo API Gateway e ALB internos."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('consulta assinada retorna 200', () => pm.response.to.have.status(200));",
                "pm.test('disponibilidade inicial é 2', () => pm.expect(pm.response.json().available).to.eql(2));"
              ] }
            }
          ]
        },
        {
          "name": "03 | Criar reserva assinada",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{reservationKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 1,\n  \"customer\": { \"name\": \"Postman AWS\", \"email\": \"{{customerEmail}}\" }\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{commandBaseUrl}}/events/{{eventId}}/reservations",
            "description": "Cria uma reserva pelo caminho assinado. Em AWS, customerEmail precisa ser aceito pelo SES."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('cria reserva assinada com 201', () => pm.response.to.have.status(201));",
                "const reservation = pm.response.json();",
                "pm.test('reserva AWS inicia pendente', () => pm.expect(reservation.status).to.eql('PENDING'));",
                "pm.collectionVariables.set('reservationId', reservation.id);"
              ] }
            }
          ]
        },
        {
          "name": "04 | Repetir reserva assinada",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{reservationKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 1,\n  \"customer\": { \"name\": \"Postman AWS\", \"email\": \"{{customerEmail}}\" }\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{commandBaseUrl}}/events/{{eventId}}/reservations",
            "description": "O retry assinado usa a mesma chave e devolve a mesma reserva."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('replay assinado retorna 201', () => pm.response.to.have.status(201));",
                "pm.test('replay devolve a mesma reserva', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('reservationId')));"
              ] }
            }
          ]
        },
        {
          "name": "05 | Consultar reserva assinada",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{queryBaseUrl}}/reservations/{{reservationId}}",
            "description": "Confirma a reserva pelo query-api, sem depender do cache de disponibilidade."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('consulta reserva assinada retorna 200', () => pm.response.to.have.status(200));",
                "pm.test('reserva referencia o evento criado', () => pm.expect(pm.response.json().event.id).to.eql(pm.collectionVariables.get('eventId')));"
              ] }
            }
          ]
        },
        {
          "name": "06 | Rejeitar capacidade insuficiente assinada",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{insufficientCapacityKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2,\n  \"customer\": { \"name\": \"Capacidade AWS\", \"email\": \"{{customerEmail}}\" }\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{commandBaseUrl}}/events/{{eventId}}/reservations",
            "description": "Com apenas uma unidade restante, pedir duas retorna conflito e não autoriza oversell."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('conflito assinado retorna 409', () => pm.response.to.have.status(409));",
                "pm.test('conflito é Problem Details', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));"
              ] }
            }
          ]
        },
        {
          "name": "07 | Cancelar reserva assinada",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Idempotency-Key", "value": "{{cancelReservationKey}}", "type": "text" } ],
            "url": "{{commandBaseUrl}}/reservations/{{reservationId}}",
            "description": "Cancela antes do prazo, devolve capacidade e registra CANCELLED_BY_REQUEST."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('cancelamento assinado retorna 200', () => pm.response.to.have.status(200));",
                "const reservation = pm.response.json();",
                "pm.test('cancelamento mantém motivo auditável', () => { pm.expect(reservation.status).to.eql('CANCELLED'); pm.expect(reservation.closureReason.code).to.eql('CANCELLED_BY_REQUEST'); });"
              ] }
            }
          ]
        },
        {
          "name": "08 | Confirmar capacidade devolvida assinada",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{queryBaseUrl}}/events/{{eventId}}",
            "description": "Confirma que o cancelamento devolveu a capacidade ao evento."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('consulta pós-cancelamento retorna 200', () => pm.response.to.have.status(200));",
                "pm.test('capacidade AWS volta a 2', () => pm.expect(pm.response.json().available).to.eql(2));"
              ] }
            }
          ]
        }
      ]
    }
  ]
}
