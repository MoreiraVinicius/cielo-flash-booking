{
  "info": {
    "_postman_id": "a79db9d6-9874-41cb-a631-a5391769bc25",
    "name": "Flash Booking AWS Demo",
    "description": "Validação mínima do case no ambiente demo da AWS. Execute as requisições na ordem da coleção. As credenciais SigV4 são temporárias e nunca devem ser salvas no repositório.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "awsv4",
    "awsv4": [
      {
        "key": "accessKey",
        "value": "{{awsAccessKeyId}}",
        "type": "string"
      },
      {
        "key": "secretKey",
        "value": "{{awsSecretAccessKey}}",
        "type": "string"
      },
      {
        "key": "sessionToken",
        "value": "{{awsSessionToken}}",
        "type": "string"
      },
      {
        "key": "region",
        "value": "{{awsRegion}}",
        "type": "string"
      },
      {
        "key": "service",
        "value": "execute-api",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  pm.collectionVariables.set('runId', Date.now().toString());",
          "}",
          ""
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Security boundary",
      "item": [
        {
          "name": "Reject unsigned request",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "00000000-0000-0000-0000-000000000000"
              ]
            },
            "description": "Comprova que o endpoint público não aceita chamadas sem IAM/SigV4."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('IAM/SigV4 is required', function () {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  ""
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Required case flow",
      "item": [
        {
          "name": "Create event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "event-{{runId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AWS case validation {{runId}}\",\n  \"capacity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Event is created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.be.a('string');",
                  "  pm.expect(body.capacity).to.eql(10);",
                  "  pm.expect(body.available).to.eql(10);",
                  "  pm.collectionVariables.set('eventId', body.id);",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Get event",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Event exposes total and available capacity', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get('eventId'));",
                  "  pm.expect(body.capacity).to.eql(10);",
                  "  pm.expect(body.available).to.eql(10);",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Create reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "reservation-{{runId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3,\n  \"customer\": {\n    \"name\": \"AWS Demo Validation\",\n    \"email\": \"{{customerEmail}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "reservations"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reservation is pending and linked to the event', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.eventId).to.eql(pm.collectionVariables.get('eventId'));",
                  "  pm.expect(body.quantity).to.eql(3);",
                  "  pm.expect(body.status).to.eql('PENDING');",
                  "  pm.expect(body.closureReason).to.eql(null);",
                  "  pm.collectionVariables.set('reservationId', body.id);",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Replay reservation idempotently",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "reservation-{{runId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3,\n  \"customer\": {\n    \"name\": \"AWS Demo Validation\",\n    \"email\": \"{{customerEmail}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "reservations"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Replay returns the original reservation', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('reservationId'));",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Get reservation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{reservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{reservationId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reservation details are complete', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get('reservationId'));",
                  "  pm.expect(body.event.id).to.eql(pm.collectionVariables.get('eventId'));",
                  "  pm.expect(body.customer.email).to.eql(pm.collectionVariables.get('customerEmail').toLowerCase());",
                  "  pm.expect(body.quantity).to.eql(3);",
                  "  pm.expect(body.status).to.eql('PENDING');",
                  "  pm.expect(body.expiresAt).to.be.a('string');",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Reject insufficient capacity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "over-capacity-{{runId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 8,\n  \"customer\": {\n    \"name\": \"AWS Demo Validation\",\n    \"email\": \"{{customerEmail}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "reservations"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Capacity cannot go below zero', function () {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json().code).to.eql('resource-conflict');",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel reservation",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "cancel-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{reservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{reservationId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cancellation closes the reservation', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('CANCELLED');",
                  "  pm.expect(body.closureReason.code).to.eql('CANCELLED_BY_REQUEST');",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Get event after cancellation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cancellation returns capacity exactly once', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.capacity).to.eql(10);",
                  "  pm.expect(body.available).to.eql(10);",
                  "});",
                  ""
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Contract errors",
      "item": [
        {
          "name": "Reject command without Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Missing idempotency key\",\n  \"capacity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mutable commands require an idempotency key', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json().code).to.eql('invalid-request');",
                  "});",
                  ""
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://19b1ing1ee.execute-api.sa-east-1.amazonaws.com/demo",
      "type": "string"
    },
    {
      "key": "awsRegion",
      "value": "sa-east-1",
      "type": "string"
    },
    {
      "key": "awsAccessKeyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "awsSecretAccessKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "awsSessionToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerEmail",
      "value": "moreiravinicius.job@gmail.com",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reservationId",
      "value": "",
      "type": "string"
    }
  ]
}
